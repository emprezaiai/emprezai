# EMPREZAI — nombres de la configuración (SIN valores reales). Los valores se ponen SOLO en el panel
# de Vercel (producción/preview) o en .env.local de este computador (desarrollo). Nunca en el chat.

# ── Públicas (llegan al navegador: NUNCA pongas aquí claves secretas) ─────────────────────────
NEXT_PUBLIC_SITE_URL=https://tudominio.com
# Modo demostración de Entrar: solo en local, NUNCA en producción.
NEXT_PUBLIC_VISTA_PREVIA=
# Enlaces de pago de Hotmart (URL del checkout con off=...)
NEXT_PUBLIC_HOTMART_CHECKOUT_ANUAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_MENSUAL=
# Supabase: URL del proyecto y clave publicable (sb_publishable_...), protegida por RLS
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ── Secretas (SOLO servidor) ───────────────────────────────────────────────────────────────────
# Supabase: clave secreta (sb_secret_...). Salta la RLS: solo webhook, cron y tareas del servidor.
SUPABASE_SECRET_KEY=
# IA (Anthropic). Modelo por defecto claude-opus-5-5; se cambia aquí sin tocar código.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Topes de gasto de IA en USD (kill-switch): al llegar, la IA se pausa y se avisa a la dueña.
LIMITE_DIARIO_USD=5
LIMITE_MENSUAL_USD=50
# Correos (Resend) con dominio propio verificado, ej. "EMPREZAI <hola@tudominio.com>"
RESEND_API_KEY=
EMAIL_FROM=
# Hotmart: token del webhook (pestaña Autenticación) + producto y ofertas permitidos
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=
HOTMART_OFFER_ANUAL=
HOTMART_OFFER_MENSUAL=
# Tarea diaria (Vercel Cron): un texto largo al azar
CRON_SECRET=
